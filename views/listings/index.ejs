  #filters::-webkit-scrollbar {
    display: none;
  }

  /* प्रत्येक सिंगल फिल्टर आयटम */
  .filter {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
