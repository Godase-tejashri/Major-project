      </a>

      <a href="/listings?category=arctic" class="filter <%= currentCategory === 'arctic' ? 'active-filter' : '' %>">
         <div><i class="fa-solid fa-snowflake"></i></div>
         <p>Arctic</p>
      </a>

      <div class="filter">
          <i class="fa-solid fa-umbrella-beach"></i>
          <p>Beachfront</p>
      </div>

      <a href="/listings?category=desert" class="filter <%= currentCategory === 'desert' ? 'active-filter' : '' %>">
         <div><i class="fa-solid fa-sun"></i></div>
         <p>Deserts</p>
      </a>

      <a href="/listings?category=historical" class="filter <%= currentCategory === 'historical' ? 'active-filter' : '' %>">
         <div><i class="fa-solid fa-building-columns"></i></div>
         <p>Historical</p>
      </a>

      <a href="/listings?category=islands" class="filter <%= currentCategory === 'islands' ? 'active-filter' : '' %>">
         <div><i class="fa-solid fa-earth-oceania"></i></div>
         <p>Islands</p>
      </a>
