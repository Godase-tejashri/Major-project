  .listing-link {
    text-decoration: none;
    color: inherit;
  }
  .listing-card {
    transition: transform 0.2s ease-in-out;
    background-color: #fff;
  }
  .listing-card:hover {
    transform: scale(1.02);
    cursor: pointer;
  }
  .card-img-top {
    width: 100%;
    object-fit: cover;
    border-radius: 0.75rem !important;
    transition: opacity 0.2s ease-in-out;
  }
  .listing-card:hover .card-img-top {
    opacity: 0.82; 
  }

  /* फिल्टर्सचा मुख्य रॅपर */
  .filters-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 1.5rem 0; 
    padding: 0 55px; 
    width: 100%;
  }

  /* आयकॉन्सची स्क्रोल होणारी ओळ */
  #filters {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap; 
    align-items: center;
    overflow-x: auto;
    width: 100%;       
    gap: 2rem;
    flex-grow: 1;
    scroll-behavior: smooth;
  }

  /* स्क्रोलबार लपवण्यासाठी */
  #filters::-webkit-scrollbar {
    display: none;
  }

  /* प्रत्येक सिंगल फिल्टर आयटम */
  .filter {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
    color: #717171 !important; /* एअरबीएनबीचा ओरिजिनल ग्रे रंग */
    border-bottom: 2px solid transparent;
    padding-bottom: 6px;
    min-width: fit-content;
  }

  .filter:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .filter i {
    font-size: 1.4rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .filter p {
    font-size: 0.75rem;
    margin: 0;
    font-weight: 600;
  }

  .scroll-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: white;
    border: 1px solid #ddd;
    border-radius: 50%;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0px 2px 6px rgba(0,0,0,0.15);
    z-index: 100;
    transition: 0.2s ease;
  }

  .scroll-btn:hover {
    background: #f7f7f7;
    transform: translateY(-50%) scale(1.1);
  }

  .btn-left { left: 5px; }
  .btn-right { right: 5px; }

  .active-filter {
    opacity: 1 !important;
    border-bottom: 2px solid #222222 !important; 
    padding-bottom: 3px;
    font-weight: 600;
  }

  .active-filter i {
    color: #222222 !important; 
  }
</style>

<div class="container mt-2">

  <div class="filters-wrapper ">
    
    <button class="scroll-btn btn-left" onclick="scrollFilters(-1)">
       <i class="fa-solid fa-angles-left"></i>
    </button>

