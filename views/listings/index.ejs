    margin: 0;
    font-weight: 600;
  }

  /* 🟢 डावा स्क्रोल बटण स्टाईल */
  .scroll-btn-left {
    background: white;
    border: 1px solid #ddd;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0px 1px 4px rgba(0,0,0,0.15);
    flex-shrink: 0;
    margin-right: 0.5rem;
    transition: 0.2s ease;
  }

  /* 🟢 उजवा स्क्रोल बटण स्टाईल - याला absolute वरून काढून साधे फ्लेक्स केले */
  .scroll-btn-right {
    background: white;
    border: 1px solid #ddd;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0px 1px 4px rgba(0,0,0,0.15);
    flex-shrink: 0;
    transition: 0.2s ease;
  }

  .scroll-btn-left:hover, .scroll-btn-right:hover {
    background: #f7f7f7;
    transform: scale(1.05);
  }

  .scroll-btn-left i, .scroll-btn-right i {
    font-size: 0.75rem;
    color: #222222;
  }

  .active-filter {
    color: #222222 !important;
    border-bottom: 2px solid #222222 !important; 
    font-weight: 600;
  }

  /* 🟢 टॅक्स टॉगल बॉक्स स्टाईल - जो आता फिल्टर्स संपल्यावर पहिली जागा घेईल */
  .tax-toggle {
    border: 1px solid #b0b0b0 !important;
    height: 3.1rem;
    border-radius: 12px !important;
    display: flex;
    align-items: center;
    padding: 0 1rem;
    flex-shrink: 0;
    box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    margin-left: auto; /* 👈 यामुळे टॉगल बॉक्स आणि उजवा अ‍ॅरो थेट उजव्या कोपऱ्यात ढकलले जातील */
  }

  .form-check-input-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: #222222;
    cursor: pointer;
    margin-right: 12px;
  }
  
  .form-check-input {
    cursor: pointer;
  }
</style>

